# =============================================================================
# No-Backdoor System Architecture — Test Environment Variables
# =============================================================================
# These settings are used by the Jest test suite (tests/setup.ts).
# They point to a dedicated test database so production data is never touched.
# =============================================================================

NODE_ENV=test
PORT=3001

# PostgreSQL Test Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=no_backdoor_test
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_SIZE=5

# Redis Test Instance
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=15

# JWT (test secret — does not need to be cryptographically strong)
JWT_SECRET=test-secret-key-12345
JWT_REFRESH_SECRET=test-refresh-secret-67890
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Upload Settings
UPLOAD_DIR=/tmp/test-uploads
UPLOAD_MAX_SIZE=52428800
UPLOAD_MAX_FILES=10

# Rate Limiting (disabled in test)
RATE_LIMIT_ENABLED=false

# Logging (silent in test)
LOG_LEVEL=silent

# CORS (permissive for test)
CORS_ORIGINS=*

# Feature Flags
EXPOSE_STACK_TRACES=true
