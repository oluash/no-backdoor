# =============================================================================
# No-Backdoor System — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your production values.
# NEVER commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Node environment: development | production | test
NODE_ENV=production

# Port the backend server listens on (inside container)
PORT=3000

# -----------------------------------------------------------------------------
# PostgreSQL Database
# -----------------------------------------------------------------------------
# Database host (service name in Docker network)
DB_HOST=postgres

# Database port
DB_PORT=5432

# Database name
DB_NAME=nobackdoor

# Database user
DB_USER=nbadmin

# Database password — CHANGE THIS IN PRODUCTION!
DB_PASSWORD=changeme-strong-password

# Connection pool settings
DB_POOL_MIN=2
DB_POOL_MAX=10

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
# Redis host (service name in Docker network)
REDIS_HOST=redis

# Redis port
REDIS_PORT=6379

# Redis password — CHANGE THIS IN PRODUCTION!
REDIS_PASSWORD=changeme-redis-password

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
# JWT secret key — Use a cryptographically secure 64+ character random string!
# Generate with: openssl rand -base64 64
JWT_SECRET=change-this-to-a-64-char-random-string-in-production

# Access token expiration time (e.g., 15m, 1h, 24h)
JWT_EXPIRES_IN=15m

# Refresh token expiration time (e.g., 7d, 30d)
JWT_REFRESH_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# File Upload
# -----------------------------------------------------------------------------
# Maximum upload size in bytes (default: 50MB)
UPLOAD_MAX_SIZE=52428800

# Upload directory path (inside container)
UPLOAD_DIR=/app/uploads

# -----------------------------------------------------------------------------
# CORS & Security
# -----------------------------------------------------------------------------
# Allowed CORS origin (use comma-separated list for multiple, * for any)
# In production, set this to your frontend domain!
CORS_ORIGIN=*

# Rate limit window in milliseconds (default: 15 minutes)
RATE_LIMIT_WINDOW=900000

# Maximum requests per window (default: 100)
RATE_LIMIT_MAX=100

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# Log level: error | warn | info | debug
LOG_LEVEL=info

# Log directory path
LOG_DIR=/app/logs
