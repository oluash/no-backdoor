# =============================================================================
# No-Backdoor System — Backend .dockerignore
# =============================================================================
# Files and directories excluded from Docker build context.
# This reduces build time and keeps images lean.
# =============================================================================

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# Build output
dist/
build/
*.tsbuildinfo

# Environment files
.env
.env.local
.env.*.local

# Test files
coverage/
.nyc_output/
*.test.ts
*.test.js
*.spec.ts
*.spec.js
__tests__/
__mocks__/

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
logs/
*.log

# Documentation
README.md
CHANGELOG.md
docs/

# Git
.git/
.gitignore
.gitattributes

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml

# Docker (avoid recursion)
Dockerfile*
docker-compose*.yml
.dockerignore

# Uploads & Data
uploads/
backups/
temp/
tmp/

# Misc
*.md
.editorconfig
.eslintrc*
.prettierrc*
jest.config.*
tsconfig.json
