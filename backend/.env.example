# =============================================================================
# No-Backdoor System Architecture — Environment Variables Example
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# =============================================================================

NODE_ENV=development
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=no_backdoor
DB_USER=postgres
DB_PASSWORD=changeme
DB_POOL_SIZE=20
DB_QUERY_TIMEOUT=30000
DB_SSL=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=nb:

# JWT Authentication (generate strong secrets in production)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-long
JWT_REFRESH_SECRET=your-different-refresh-secret-key-here

# Upload / File Handling
UPLOAD_DIR=/var/lib/nobackdoor/uploads
UPLOAD_MAX_SIZE=104857600
UPLOAD_MAX_FILES=10

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GENERAL_MAX=100
RATE_LIMIT_GENERAL_WINDOW_MS=900000
RATE_LIMIT_UPLOAD_MAX=10
RATE_LIMIT_AUTH_MAX=20

# WebSocket
WS_PATH=/ws
WS_HEARTBEAT_INTERVAL=30000

# Logging
LOG_LEVEL=debug
LOG_DIR=logs

# Feature Flags
LOG_HTTP_BODIES=false
