# ─────────────────────────────────────────────────────────────────────────────
# No-Backdoor System — Railway Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# DATABASE_URL is auto-provided by Railway PostgreSQL plugin
# REDIS_URL is auto-provided by Railway Redis plugin
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=3000

# PostgreSQL (Railway auto-provides DATABASE_URL)
# DATABASE_URL=postgresql://...

# JWT Secrets — CHANGE THESE IN PRODUCTION
JWT_SECRET=change-this-to-a-random-64-char-string
JWT_ACCESS_SECRET=change-this-to-another-random-string
JWT_REFRESH_SECRET=change-this-to-yet-another-random-string
JWT_ACCESS_EXPIRY=3600
JWT_REFRESH_EXPIRY=604800

# CORS — Allow frontend domain
CORS_ORIGINS=https://your-frontend.railway.app,http://localhost:5173
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GENERAL_MAX=200
RATE_LIMIT_AUTH_MAX=20

# Logging
LOG_LEVEL=info

# Uploads (use /tmp on Railway — ephemeral)
UPLOAD_DIR=/tmp/nobackdoor-uploads
UPLOAD_TEMP_DIR=/tmp/nobackdoor-uploads
UPLOAD_MAX_SIZE=104857600

# Redis (Railway auto-provides REDIS_URL)
# REDIS_URL=redis://...
REDIS_HOST=localhost
REDIS_PORT=6379
